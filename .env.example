# ============================================================
# Stock News Scheduler - Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- Scheduler ---
# How often to run the news search (in minutes, default: 60)
SCHEDULER_INTERVAL_MINUTES=60

# --- Storage ---
# SQLite database file path
DB_PATH=stock_news.db

# --- News Search ---
# Max news items to fetch per stock
MAX_NEWS_PER_STOCK=5
# News search language (e.g., en, zh-TW, zh-HK)
NEWS_LANG=en

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Telegram Bot (Required) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
