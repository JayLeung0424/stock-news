# ============================================================
# Stock News Scheduler - Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- Futu OpenD Connection ---
# FutuOpenD gateway host (default: 127.0.0.1)
FUTU_HOST=127.0.0.1
# FutuOpenD gateway port (default: 11111)
FUTU_PORT=11111

# --- Scheduler ---
# How often to run the news search (in minutes, default: 60)
SCHEDULER_INTERVAL_MINUTES=60

# --- Storage ---
# SQLite database file path
DB_PATH=stock_news.db

# --- News Search ---
# Max news items to fetch per stock
MAX_NEWS_PER_STOCK=5
# News search language (e.g., zh-TW, zh-HK, en)
NEWS_LANG=zh-HK

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
